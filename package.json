{
  "name": "achievement-hunter",
  "productName": "Achievement Hunter",
  "version": "0.2.0",
  "description": "Brakujące osiągnięcia Steam i sposoby, jak je zdobyć — bez logowania do Steam.",
  "author": "YoungRedfox",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "demo": "node scripts/dev.mjs --demo",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "icon": "electron scripts/make-icon.cjs",
    "build": "tsc --noEmit && vite build && node scripts/build-main.mjs",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "release": "node scripts/release.mjs"
  },
  "build": {
    "appId": "com.achievementhunter.app",
    "productName": "Achievement Hunter",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Achievement Hunter",
      "artifactName": "AchievementHunter-Setup-${version}.${ext}"
    },
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "copyright": "Copyright © 2026 YoungRedfox. Wszelkie prawa zastrzeżone.",
    "publish": [
      {
        "provider": "github",
        "owner": "YoungRedfox",
        "repo": "achievement-hunter-releases",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-updater": "^6.8.11",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
